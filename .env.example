APP_NAME="SiteCheck"
APP_ENV=local
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=false
APP_URL=http://localhost:8102
APP_TIMEZONE=UTC

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Demo mode: shows the reset banner and schedules the hourly history reset.
DEMO_MODE=true

# SiteCheck runtime limits (seconds / bytes)
SITECHECK_CONNECT_TIMEOUT=5
SITECHECK_REQUEST_TIMEOUT=12
SITECHECK_TLS_TIMEOUT=8
SITECHECK_MAX_BODY_BYTES=524288
SITECHECK_MAX_HEADER_BYTES=65536
SITECHECK_MAX_REDIRECTS=5
SITECHECK_DNS_BUDGET=8
SITECHECK_SCAN_TOTAL=60
# Set to true only when the app is served over HTTPS; HSTS is sent conditionally.
SITECHECK_HSTS=false
# Optional comma-separated DNS resolvers for the raw CAA lookup.
# SITECHECK_DNS_RESOLVERS=1.1.1.1,8.8.8.8
